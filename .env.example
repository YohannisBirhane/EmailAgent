# ======================================================
# MailPilot Full-Stack Environment Configuration (.env)
# ======================================================

# 1. PostgreSQL Database Configuration (Pre-configured Defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=mailpilot

# 2. Go Backend Settings
DB_HOST=postgres
DB_PORT=5432
PORT=4000

# 3. Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
